# ================================
# Supabase 数据库和存储配置
# ================================

# Supabase 项目 URL
# 在 Supabase Dashboard -> Settings -> API 中找到
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase 匿名访问密钥
# 在 Supabase Dashboard -> Settings -> API 中找到
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase 服务角色密钥 (可选，用于服务器端操作)
# 在 Supabase Dashboard -> Settings -> API 中找到
# 注意：这个密钥具有管理员权限，请妥善保管，不要泄露到客户端
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ================================
# 图像生成 API 配置
# ================================

# Gemini Imagen 图像生成API配置 (主要)
# API密钥获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 大香蕉(Nano Banana) 图像生成API配置 (备用)
# API密钥获取地址: https://docs.nanobananaapi.ai/cn/nanobanana-api/generate-image-pro
NANO_BANANA_API_KEY=your_nano_banana_api_key_here

# ================================
# 存储配置说明
# ================================

# 图片存储配置
# 项目使用 Supabase Storage 来存储生成的图片文件
# 存储桶名称: story-images
# 最大文件大小: 10MB
# 支持的文件格式: jpg, jpeg, png, webp

# 目录结构:
# - generated/: 通用生成的图片
# - characters/: 角色图片
# - story-pages/: 故事页面插图
# - exports/: 导出的图片
# - temp/: 临时图片文件

# 初始化存储:
# 运行以下命令初始化 Supabase Storage:
# npm run setup-storage

# 注意事项:
# 1. 确保 Supabase 账户有创建存储桶的权限
# 2. 如果自动创建失败，可以手动在 Supabase Dashboard 中创建存储桶
# 3. 存储桶需要设置为公开访问才能正常显示图片